# Copy this file to .env for local development
# Never commit .env to git — keep it private

# A long random string — generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Set to "true" only on your local machine, never in production
FLASK_DEBUG=false

# Database connection string
# Local dev: leave this unset — app uses SQLite automatically
# Production (Render/Railway): set this to the PostgreSQL URL they provide
# Example: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://...
